# قاعدة البيانات — PostgreSQL (مثال محلي؛ استخدم رابط المزود في الإنتاج)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/student_followup?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/student_followup?schema=public"

# المصادقة — السر 32+ حرفاً، والرابط عنوان الموقع العام في الإنتاج
BETTER_AUTH_SECRET="change-me-32-chars-minimum-secret"
BETTER_AUTH_URL="http://localhost:3000"

# المدرسة
SCHOOL_NAME="مدرسة الجسر الحلقة الثانية بنين"
SCHOOL_TIMEZONE="Asia/Muscat"

# تيليجرام
TELEGRAM_BOT_TOKEN=""                    # من BotFather — الإرسال ومعالجة البوت
TELEGRAM_BOT_USERNAME="aljasr_students_bot"
# سر تحقق الـwebhook — يُضبط نفسه في setWebhook عند النشر (إلزامي للإنتاج)
TELEGRAM_WEBHOOK_SECRET=""

# حماية مسارات /api/cron/* — سر عشوائي؛ Vercel Cron يرسله تلقائياً
CRON_SECRET=""
