{
  "name": "student-followup",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "نظام متابعة الطلاب — Next.js Full Stack",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "prisma generate --schema packages/db/prisma/schema.prisma && next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "npm run test --workspaces --if-present",
    "poll:telegram": "tsx scripts/telegram-poll.ts",
    "db:generate": "npm run generate -w @app/db",
    "db:migrate": "npm run migrate -w @app/db",
    "db:studio": "npm run studio -w @app/db"
  },
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=10"
  },
  "dependencies": {
    "@app/auth": "*",
    "@app/core": "*",
    "@app/db": "*",
    "@prisma/client": "6.2.1",
    "@react-pdf/renderer": "^4.1.6",
    "better-auth": "1.1.17",
    "grammy": "1.32.0",
    "next": "15.5.28",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.10.5",
    "@types/react": "19.0.4",
    "@types/react-dom": "19.0.2",
    "postcss": "8.4.49",
    "tailwindcss": "4.3.3",
    "tsx": "4.19.2",
    "typescript": "5.7.2"
  }
}
