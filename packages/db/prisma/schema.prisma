// نظام متابعة الطلاب — مخطط PostgreSQL
// المصدر الوحيد للحقيقة في النسخة الجديدة

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============ المصادقة (Better Auth) ============

enum Role {
  admin
  staff
  teacher
  guardian
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String?   @unique
  emailVerified Boolean   @default(false)
  image         String?
  username      String?   @unique
  role          Role      @default(teacher)
  isActive      Boolean   @default(true)
  phone         String?
  telegramChatId String?  @unique
  telegramState Json?
  permissions   Json?       // أقسام الإدارة المفوَّضة لدور staff — قائمة مفاتيح
  mustChangePassword Boolean @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions        Session[]
  accounts        Account[]
  memberships     Membership[]
  guardianProfile GuardianProfile?
  teacherProfile  TeacherProfile?
  auditEvents     AuditEvent[]
  weeklyPlans     WeeklyPlan[]
  dutyAssignments DutyAssignment[]

  @@map("users")
}

model Membership {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role
  createdAt DateTime @default(now())

  @@unique([userId, role])
  @@map("memberships")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verifications")
}

// ============ المدرسة والتقويم ============

model SchoolSettings {
  id                      String  @id @default("school")
  schoolName              String
  timezone                String  @default("Asia/Muscat")
  periodsPerDay           Int     @default(8)
  absentFullDayThreshold  Int     @default(3)   // 3 حصص غياب = غياب يوم
  excusedFullDayThreshold Int     @default(3)
  weekDays                Int[]   @default([0, 1, 2, 3, 4]) // 0=الأحد
  autoAbsenceAlert        Boolean @default(false) // إشعار ولي الأمر آلياً عند اكتمال حالة الغياب
  policyVersion           Int     @default(1)
  constraintsJson         String?                 // قيود محرك الجدولة — JSON نص
  updatedAt               DateTime @updatedAt

  @@map("school_settings")
}

model AcademicYear {
  id        String   @id @default(cuid())
  name      String   // "2026/2027"
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  isCurrent Boolean  @default(false)

  terms       Term[]
  classes     ClassGroup[]
  enrollments Enrollment[]
  assignments TeachingAssignment[]

  @@unique([name])
  @@map("academic_years")
}

model Term {
  id             String   @id @default(cuid())
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  name           String
  startDate      DateTime @db.Date
  endDate        DateTime @db.Date

  assessments    Assessment[]
  evaluations    Evaluation[]
  reports        ReportSnapshot[]

  @@unique([academicYearId, name])
  @@map("terms")
}

model CalendarDay {
  id          String   @id @default(cuid())
  date        DateTime @db.Date @unique
  isSchoolDay Boolean  @default(true)
  note        String?

  @@map("calendar_days")
}

model PeriodDefinition {
  id     String @id @default(cuid())
  number Int    @unique
  label  String?
  startTime String? // "08:00"
  endTime   String?

  @@map("period_definitions")
}

// ============ الصفوف والمواد والطلاب ============

model ClassGroup {
  id             String   @id @default(cuid())
  name           String   // "G6-GEN-3L"
  displayName    String   // "الصف السادس - شعبة 3"
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  gradeId        String?  // مستوى الصف للكوتا والجدولة
  grade          GradeLevel? @relation(fields: [gradeId], references: [id])
  isActive       Boolean  @default(true)

  students        Enrollment[]
  assignments     TeachingAssignment[]
  timetableSlots  TimetableSlot[]
  lessonSessions  LessonSession[]
  assessments     Assessment[]
  weeklyPlans     WeeklyPlan[]
  planPublications ClassWeeklyPlanPublication[]

  @@unique([academicYearId, name])
  @@map("class_groups")
}

model Subject {
  id       String @id @default(cuid())
  name     String @unique
  isActive Boolean @default(true)
  // خصائص الجدولة — من «البرنامج المدرسي»
  code          String?
  color         String?  @default("#8b5cf6")
  preferEarly   Boolean  @default(false) // تفضيل الحصص المبكرة
  maxPerDay     Int?     // أقصى حصص يومية لكل شعبة
  minDaysPerWeek Int?    // أدنى أيام ظهور المادة لكل شعبة

  assignments    TeachingAssignment[]
  timetableSlots TimetableSlot[]
  lessonSessions LessonSession[]
  assessments    Assessment[]
  evaluations    Evaluation[]
  weeklyPlans    WeeklyPlan[]
  gradeQuotas       SubjectGradeQuota[]
  unavailabilities  SubjectUnavailability[]

  @@map("subjects")
}

model Student {
  id            String   @id @default(cuid())
  fullName      String
  gender        String?
  guardianName  String?  // ولي الأمر قبل تفعيل الدعوة
  guardianPhone String?  // يتدفق إلى GuardianProfile.phone عند التفعيل
  isActive      Boolean  @default(true)
  legacyId  Int?     @unique   // رقم SQLite القديم للمصالحة
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollments       Enrollment[]
  guardians         GuardianStudent[]
  attendanceEntries AttendanceEntry[]
  dailySummaries    DailySummary[]
  behaviorEntries   BehaviorEntry[]
  notes             Note[]
  grades            Grade[]
  evaluations       Evaluation[]
  reportSnapshots   ReportSnapshot[]
  reportViews       ReportViewEvent[]

  @@index([isActive])
  @@map("students")
}

model Enrollment {
  id             String       @id @default(cuid())
  studentId      String
  student        Student      @relation(fields: [studentId], references: [id])
  classId        String
  class          ClassGroup   @relation(fields: [classId], references: [id])
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  startDate      DateTime?    @db.Date
  endDate        DateTime?    @db.Date

  @@index([classId, academicYearId])
  @@index([studentId, academicYearId])
  @@map("enrollments")
}

// ============ أولياء الأمور ============

model GuardianProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone           String?
  preferredChannel String  @default("telegram") // telegram | portal
  createdAt       DateTime @default(now())

  children GuardianStudent[]

  @@map("guardian_profiles")
}

model TeacherProfile {
  id             String  @id @default(cuid())
  userId         String  @unique
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultSubject String?
  // قيود الجدولة — من «البرنامج المدرسي»
  specialization  String?
  employeeNo      String?
  weeklyLessons   Int      @default(22) // النصاب التعاقدي الأسبوعي
  maxDailyLessons Int?
  maxConsecutive  Int?
  maxWorkingDays  Int?
  avoidLastPeriod Boolean  @default(false)
  color           String   @default("#3b82f6")

  unavailabilities TeacherAvailability[]

  @@map("teacher_profiles")
}

model GuardianStudent {
  id            String          @id @default(cuid())
  guardianId    String
  guardian      GuardianProfile @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  studentId     String
  student       Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  relationship  String          @default("parent") // parent | other
  verified      Boolean         @default(false)
  canViewReports Boolean        @default(true)
  createdById   String?         // من أنشأ الربط في الإدارة
  createdAt     DateTime        @default(now())

  @@unique([guardianId, studentId])
  @@map("guardian_students")
}

// ============ الإسنادات والجدول ============

model TeachingAssignment {
  id             String       @id @default(cuid())
  teacherId      String
  classId        String
  class          ClassGroup   @relation(fields: [classId], references: [id])
  subjectId      String
  subject        Subject      @relation(fields: [subjectId], references: [id])
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  isActive       Boolean      @default(true)

  generatedEntries GeneratedTimetableEntry[]

  @@unique([teacherId, classId, subjectId, academicYearId])
  @@map("teaching_assignments")
}

model TimetableSlot {
  id           String            @id @default(cuid())
  assignmentId String?
  teacherId    String
  classId      String
  class        ClassGroup        @relation(fields: [classId], references: [id])
  subjectId    String
  subject      Subject           @relation(fields: [subjectId], references: [id])
  weekday      Int               // 0=الأحد .. 6=السبت
  period       Int
  effectiveFrom DateTime         @db.Date
  effectiveTo   DateTime?        @db.Date
  version      Int               @default(1)

  lessonSessions LessonSession[]

  @@index([teacherId, weekday])
  @@index([classId, weekday])
  @@map("timetable_slots")
}

// ============ الجدولة الآلية (من «البرنامج المدرسي») ============

// مستوى الصف الدراسي — تتبعه الشعب (ClassGroup) وتُعرَّف عليه كوتا المواد
model GradeLevel {
  id    String @id @default(cuid())
  name  String @unique // "الصف السادس"
  order Int    @default(0)

  classes     ClassGroup[]
  gradeQuotas SubjectGradeQuota[]

  @@map("grade_levels")
}

// النصاب الأسبوعي للمادة في صف دراسي — يُشتق منه عدد حصص كل إسناد
model SubjectGradeQuota {
  id            String     @id @default(cuid())
  subjectId     String
  subject       Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  gradeId       String
  grade         GradeLevel @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  weeklyPeriods Int        @default(0)

  @@unique([subjectId, gradeId])
  @@map("subject_grade_quotas")
}

// خانة زمنية غير متاحة للمعلم (teacherId = User.id كبقية النظام)
model TeacherAvailability {
  id          String         @id @default(cuid())
  teacherId   String
  teacher     TeacherProfile @relation(fields: [teacherId], references: [userId], onDelete: Cascade)
  dayOfWeek   Int
  periodIndex Int // فهرس الخانة في اليوم (DayPeriodDef.index)

  @@unique([teacherId, dayOfWeek, periodIndex])
  @@map("teacher_unavailabilities")
}

// خانة زمنية محظورة على المادة — تنطبق على كل معلميها
model SubjectUnavailability {
  id          String  @id @default(cuid())
  subjectId   String
  subject     Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  dayOfWeek   Int
  periodIndex Int

  @@unique([subjectId, dayOfWeek, periodIndex])
  @@map("subject_unavailabilities")
}

// تعريف الحصص/الاستراحات لكل يوم دوام على حدة (الجمعة جدول مختلف)
model DayPeriodDef {
  id          String  @id @default(cuid())
  dayOfWeek   Int     // 0=الأحد .. 6=السبت
  index       Int     // ترتيب الخانة في اليوم (يشمل الاستراحات)
  label       String  // "الحصة 1" أو "استراحة"
  start       String? // "07:30"
  end         String?
  isBreak     Boolean @default(false)

  @@unique([dayOfWeek, index])
  @@map("day_period_defs")
}

// جدول مولّد قابل للمراجعة قبل تحويله إلى timetable_slots
model GeneratedTimetable {
  id           String   @id @default(cuid())
  name         String   @default("الجدول الرئيسي")
  status       String   @default("DRAFT") // DRAFT | PUBLISHED | ARCHIVED
  qualityScore Float?
  statsJson    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  entries GeneratedTimetableEntry[]
  jobs    TimetableJob[]

  @@map("generated_timetables")
}

model GeneratedTimetableEntry {
  id           String @id @default(cuid())
  timetableId  String
  timetable    GeneratedTimetable @relation(fields: [timetableId], references: [id], onDelete: Cascade)
  dayOfWeek    Int
  periodIndex  Int    // فهرس الخانة في اليوم (DayPeriodDef.index)
  assignmentId String
  assignment   TeachingAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@unique([timetableId, dayOfWeek, periodIndex, assignmentId])
  @@index([assignmentId])
  @@map("generated_timetable_entries")
}

// مهمة توليد غير متزامنة — الواجهة تستعلم عن حالتها
model TimetableJob {
  id              String   @id @default(cuid())
  status          String   @default("PENDING") // PENDING | RUNNING | DONE | FAILED | INFEASIBLE
  logJson         String?
  diagnosticsJson String?
  timetableId     String?
  timetable       GeneratedTimetable? @relation(fields: [timetableId], references: [id])
  error           String?
  createdAt       DateTime @default(now())
  finishedAt      DateTime?

  @@map("timetable_jobs")
}

// ============ الحصص والحضور ============

enum LessonStatus {
  planned
  draft
  submitted
  reopened
  cancelled
}

model LessonSession {
  id              String       @id @default(cuid())
  date            DateTime     @db.Date
  period          Int
  classId         String
  class           ClassGroup   @relation(fields: [classId], references: [id])
  subjectId       String
  subject         Subject      @relation(fields: [subjectId], references: [id])
  teacherId       String       // المعلم المسند وقت الإنشاء (تاريخي)
  timetableSlotId String?
  timetableSlot   TimetableSlot? @relation(fields: [timetableSlotId], references: [id])
  status          LessonStatus @default(planned)
  submittedById   String?
  submittedAt     DateTime?
  version         Int          @default(1)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  entries         AttendanceEntry[]
  behaviorEntries BehaviorEntry[]

  @@unique([classId, date, period])
  @@index([teacherId, date])
  @@index([date])
  @@map("lesson_sessions")
}

enum AttendanceStatus {
  present
  absent
  excused
  late
}

model AttendanceEntry {
  id              String           @id @default(cuid())
  lessonSessionId String
  lessonSession   LessonSession    @relation(fields: [lessonSessionId], references: [id], onDelete: Cascade)
  studentId       String
  student         Student          @relation(fields: [studentId], references: [id])
  status          AttendanceStatus
  isAssumed       Boolean          @default(false) // اعتمدها المعلم ضمن "بقية الكشف حاضرون"
  recordedById    String?
  revision        Int              @default(1)
  legacyId        Int?             // مرجع سجل قديم عند الترحيل
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([lessonSessionId, studentId])
  @@index([studentId])
  @@map("attendance_entries")
}

enum DayStatus {
  present
  absent
  excused
  partial   // غياب جزئي — حصة أو حصتان
  late
  unknown   // لا سجلات كافية
}

model DailySummary {
  id            String    @id @default(cuid())
  studentId     String
  student       Student   @relation(fields: [studentId], references: [id])
  date          DateTime  @db.Date
  status        DayStatus
  absentCount   Int       @default(0)
  excusedCount  Int       @default(0)
  lateCount     Int       @default(0)
  recordedCount Int       @default(0) // حصص مرصودة
  expectedCount Int       @default(0) // حصص مجدولة ذلك اليوم
  policyVersion Int       @default(1)
  computedAt    DateTime  @default(now())

  @@unique([studentId, date])
  @@index([date])
  @@map("daily_summaries")
}

// ============ السلوك والملاحظات ============

enum Audience {
  internal
  family
}

enum BehaviorCategory {
  excellent
  committed
  needs_followup
}

model BehaviorEntry {
  id              String            @id @default(cuid())
  studentId       String
  student         Student           @relation(fields: [studentId], references: [id])
  date            DateTime          @db.Date
  period          Int?
  lessonSessionId String?
  lessonSession   LessonSession?    @relation(fields: [lessonSessionId], references: [id])
  teacherId       String
  category        BehaviorCategory?
  text            String?
  audience        Audience          @default(internal)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([studentId, date])
  @@map("behavior_entries")
}

model Note {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id])
  authorId  String?
  date      DateTime @db.Date
  category  String   // free | positive | absence | behavior
  text      String
  audience  Audience @default(internal)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId, date])
  @@map("notes")
}

// ============ الدرجات والتقييمات ============

model Assessment {
  id          String    @id @default(cuid())
  teacherId   String
  classId     String
  class       ClassGroup @relation(fields: [classId], references: [id])
  subjectId   String
  subject     Subject    @relation(fields: [subjectId], references: [id])
  termId      String?
  term        Term?      @relation(fields: [termId], references: [id])
  title       String
  kind        String    @default("quiz") // quiz | homework | exam | participation
  date        DateTime  @db.Date
  maxScore    Float
  createdAt   DateTime  @default(now())

  grades Grade[]

  // الهوية تشمل المعلم والمادة — لا دمج بين مادتين بنفس العنوان
  @@unique([teacherId, subjectId, classId, title, date])
  @@map("assessments")
}

model Grade {
  id           String     @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student    @relation(fields: [studentId], references: [id])
  score        Float?
  note         String?
  updatedAt    DateTime   @updatedAt

  @@unique([assessmentId, studentId])
  @@map("grades")
}

model Evaluation {
  id        String    @id @default(cuid())
  teacherId String
  subjectId String?
  subject   Subject?  @relation(fields: [subjectId], references: [id])
  studentId String
  student   Student   @relation(fields: [studentId], references: [id])
  termId    String?
  term      Term?     @relation(fields: [termId], references: [id])
  weekStart DateTime? @db.Date // أسبوع التقييم — null = سجل قديم بلا أسبوع
  category  String    // مفتاح بند التقييم
  value     String
  updatedAt DateTime  @updatedAt

  // كل معلم يقيّم بندّه دون استبدال تقييم معلم آخر — والقيمة أسبوعية
  @@unique([teacherId, subjectId, studentId, termId, weekStart, category])
  @@map("evaluations")
}

// ============ التقارير ============

enum ReportStatus {
  draft
  approved
  sent
  failed
}

model ReportSnapshot {
  id           String       @id @default(cuid())
  studentId    String
  student      Student      @relation(fields: [studentId], references: [id])
  termId       String?
  term         Term?        @relation(fields: [termId], references: [id])
  rangeStart   DateTime     @db.Date
  rangeEnd     DateTime     @db.Date
  contentJson  Json         // البيانات المجمّعة وقت الاعتماد
  renderedHtml String?
  status       ReportStatus @default(draft)
  approvedById String?
  approvedAt   DateTime?
  version      Int          @default(1)
  createdAt    DateTime     @default(now())

  @@index([studentId, rangeStart])
  @@map("report_snapshots")
}

model ReportViewEvent {
  id               String         @id @default(cuid())
  reportSnapshotId String
  studentId        String
  student          Student        @relation(fields: [studentId], references: [id])
  viewerUserId     String
  viewedAt         DateTime       @default(now())

  @@index([reportSnapshotId])
  @@map("report_view_events")
}

// ============ التواصل والطابور ============

enum OutboxStatus {
  pending
  processing
  done
  failed
  cancelled
}

model OutboxEvent {
  id             String       @id @default(cuid())
  type           String       // report_send | telegram_message | ...
  payload        Json
  channel        String       @default("telegram")
  status         OutboxStatus @default(pending)
  idempotencyKey String       @unique
  attempts       Int          @default(0)
  nextAttemptAt  DateTime     @default(now())
  lastError      String?
  createdAt      DateTime     @default(now())

  deliveries DeliveryAttempt[]

  @@index([status, nextAttemptAt])
  @@map("outbox_events")
}

model DeliveryAttempt {
  id             String      @id @default(cuid())
  outboxEventId  String
  outboxEvent    OutboxEvent @relation(fields: [outboxEventId], references: [id], onDelete: Cascade)
  channel        String
  result         String      // success | failed | ambiguous
  providerMsgId  String?
  error          String?
  attemptedAt    DateTime    @default(now())

  @@index([outboxEventId])
  @@map("delivery_attempts")
}

model TelegramUpdateInbox {
  id          String    @id @default(cuid())
  updateId    Int       @unique
  payload     Json
  status      String    @default("pending") // pending | processed | failed
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@map("telegram_update_inbox")
}

// ============ التدقيق والترحيل ============

model AuditEvent {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@map("audit_events")
}

model ImportBatch {
  id         String   @id @default(cuid())
  kind       String   // students | legacy_full
  status     String   @default("review") // review | applied | rolled_back
  summary    Json?
  createdById String?
  createdAt  DateTime @default(now())

  records    LegacyRecordMap[]

  @@map("import_batches")
}

model LegacyRecordMap {
  id            String      @id @default(cuid())
  importBatchId String
  importBatch   ImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  legacyTable   String
  legacyId      String
  newEntityType String?
  newEntityId   String?
  createdAt     DateTime    @default(now())

  @@unique([importBatchId, legacyTable, legacyId])
  @@map("legacy_record_map")
}

model ReviewIssue {
  id          String   @id @default(cuid())
  entityType  String
  entityId    String?
  severity    String   @default("warning") // info | warning | blocking
  message     String
  resolvedAt  DateTime?
  resolvedById String?
  createdAt   DateTime @default(now())

  @@map("review_issues")
}

// ============ الخطة الأسبوعية ============

/** مساهمة معلم واحد — وحدة الإدخال: صف + مادة + أسبوع */
model WeeklyPlan {
  id          String     @id @default(cuid())
  teacherId   String
  teacher     User       @relation(fields: [teacherId], references: [id])
  classId     String
  class       ClassGroup @relation(fields: [classId], references: [id])
  subjectId   String
  subject     Subject    @relation(fields: [subjectId], references: [id])
  weekStart   DateTime   @db.Date // الاثنين — بمنطق weekStartOf
  status      String     @default("draft") // draft | submitted
  submittedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  entries     WeeklyPlanEntry[]

  @@unique([teacherId, classId, subjectId, weekStart])
  @@map("weekly_plans")
}

model WeeklyPlanEntry {
  id          String     @id @default(cuid())
  planId      String
  plan        WeeklyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  weekday     Int // مطابق أيام المدرسة settings.weekDays
  lessonTitle String?
  textbook    String?
  platforms   String?
  tests       String?
  notes       String?

  @@unique([planId, weekday])
  @@map("weekly_plan_entries")
}

/** لقطة موحّدة مجمّعة لصف+أسبوع — وحدة الإرسال لأولياء الأمور */
model ClassWeeklyPlanPublication {
  id            String     @id @default(cuid())
  classId       String
  class         ClassGroup @relation(fields: [classId], references: [id])
  weekStart     DateTime   @db.Date
  contentJson   Json // [{subjectName, teacherName, entries:[{weekday,...}]}]
  publishedById String?
  publishedAt   DateTime   @default(now())
  notifyCount   Int        @default(0)

  @@map("class_plan_publications")
}

