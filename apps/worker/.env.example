# قاعدة البيانات — PostgreSQL
# WORKER_DATABASE_URL له أولوية إن ضُبط (قاعدة منفصلة عن الويب مثلاً)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/student_followup?schema=public"
WORKER_DATABASE_URL=""

# تيليجرام
TELEGRAM_BOT_TOKEN=""
# للتطوير المحلي: استقبال الرسائل عبر polling بدل webhook
TELEGRAM_POLL="false"

# المصادقة — مطلوب لإنشاء حسابات أولياء الأمور عبر الربط الذاتي
BETTER_AUTH_SECRET="change-me-32-chars-minimum-secret"
BETTER_AUTH_URL="http://localhost:3000"

# التقارير الأسبوعية — الافتراضي الجمعة 15:00 (نهاية الأسبوع إثنين–جمعة)
REPORTS_CRON_ENABLED="false"
REPORTS_CRON="0 15 * * 5"
