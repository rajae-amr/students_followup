{
  "name": "@app/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "bundle": "esbuild src/index.ts --bundle --platform=node --format=cjs --target=node20 --external:@prisma/client --external:.prisma --external:pg-native --outfile=dist/index.cjs",
    "start": "node dist/index.cjs",
    "build": "npm run bundle",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@app/db": "*",
    "@app/core": "*",
    "@app/auth": "*",
    "pg-boss": "10.1.5",
    "grammy": "1.32.0",
    "exceljs": "4.4.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "typescript": "5.7.2",
    "tsx": "4.19.2",
    "@types/node": "22.10.5"
  }
}
